ORS_API_KEY=
HOME_NAME=Athens
HOME_LAT=37.9838
HOME_LON=23.7275
DAY_TRIP_MAX_MINUTES=90
WEEKEND_MAX_MINUTES=240
STAY_RADIUS_KM=15
DEFAULT_GUESTS=2
AIRBNB_DETAIL_TOP_N=10
